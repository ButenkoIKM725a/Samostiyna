#include <iostream>

using namespace std;
class Vector {
private:
    double* elements; 
    int size;         
public:
    Vector(int s) {
        size = s;
        elements = new double[size];
    }
    ~Vector() {
        delete[] elements;
    }
    void setElement(int index, double value) {
        if (index >= 0 && index < size) {
            elements[index] = value;
        }
    }
    void add(const Vector& other) {
        for (int i = 0; i < size; i++) {
            this->elements[i] += other.elements[i];
        }
    }
    void subtract(const Vector& other) {
        for (int i = 0; i < size; i++) {
            this->elements[i] -= other.elements[i];
        }
    }
    double scalarProduct(const Vector& other) {
        double result = 0;
        for (int i = 0; i < size; i++) {
            result += this->elements[i] * other.elements[i];
        }
        return result;
    }
    void display() {
        cout << "( ";
        for (int i = 0; i < size; i++) {
            cout << elements[i] << " ";
        }
        cout << ")" << endl;
    }
};
int main() {
    int n = 3;
    Vector v1(n);
    Vector v2(n);
    v1.setElement(0, 1.0); v1.setElement(1, 2.0); v1.setElement(2, 3.0);
    v2.setElement(0, 4.0); v2.setElement(1, 5.0); v2.setElement(2, 6.0);
    cout << "vektor 1: "; v1.display();
    cout << "vektor 2: "; v2.display();
    double dot = v1.scalarProduct(v2);
    cout << "Skalyarniy dobutok: " << dot << endl;
    v1.add(v2);
    cout << "Resultat dodavannya: "; v1.display();
    return 0;
}
